# Copy to .env.local and adjust.

# --- Server only (never exposed to the browser) ---
# API gateway. UAT: https://api-staging.occultgurukul.com · Prod: https://api.occultgurukul.com
OG_API_URL=https://api-staging.occultgurukul.com
# Build number sent at login / refresh. Digits only.
OG_APP_VERSION=1
# Package name sent at login. Confirm the web value with the backend team.
OG_PACKAGE_NAME=com.occultgurukul.app

# --- Browser ---
# Razorpay key id for the web checkout (not returned by the API, §7.2). Test key on UAT, live key on prod.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Cashfree SDK environment: sandbox (UAT) or production.
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# Features served from local mock data: comma list or "all".
# Options: auth, onboarding, account, courses, live-sessions, store, masterclasses
NEXT_PUBLIC_MOCK_FEATURES=
